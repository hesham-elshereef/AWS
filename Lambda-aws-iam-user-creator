import json
import boto3

# إنشاء العميل الخاص بـ IAM
iam = boto3.client('iam')

def lambda_handler(event, context):
    # استقبال اسم المستخدم من API Gateway
    username = event.get('username')
    
    if not username:
        return {
            'statusCode': 400,
            'body': json.dumps({'message': 'Username is required'})
        }
    
    try:
        # إضافة المستخدم في IAM
        response = iam.create_user(UserName=username)
        created_user = response['User']['UserName']
        
        return {
            'statusCode': 200,
            'body': json.dumps({
                'message': f'User {created_user} created successfully in IAM!'
            })
        }
    except iam.exceptions.EntityAlreadyExistsException:
        return {
            'statusCode': 400,
            'body': json.dumps({'message': f'User {username} already exists.'})
        }
    except Exception as e:
        return {
            'statusCode': 500,
            'body': json.dumps({'error': str(e)})
        }
