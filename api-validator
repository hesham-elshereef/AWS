
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "RegisterUserModel",
  "type": "object",
  "required": [
    "name",
    "email",
    "mobileNumber"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "mobileNumber": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{7,14}$"
    }
  },
  "additionalProperties": false
}
